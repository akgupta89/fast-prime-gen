{
  "name": "fast-prime-gen",
  "author": "akgupta89",
  "license": "MIT",
  "version": "2.0.0",
  "description": "Generate sequential primes through a generator",
  "homepage": "https://github.com/akgupta89/fast-prime-gen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akgupta89/fast-prime-gen.git"
  },
  "keywords": [
    "Postponed Sieve",
    "Sieve of Eratosthenes",
    "Prime",
    "Prime Generator",
    "Prime Number"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
